{
  "name": "fpkstudio-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:wizard": "node --import ./scripts/ts-hook.mjs scripts/check-wizard.mjs",
    "check:icon": "node --import ./scripts/ts-hook.mjs scripts/check-icon.mjs",
    "check:format": "node --import ./scripts/ts-hook.mjs scripts/check-format.mjs",
    "check:editor": "node --import ./scripts/ts-hook.mjs scripts/check-editor.mjs",
    "check:workspace": "node --import ./scripts/ts-hook.mjs scripts/check-workspace.mjs",
    "check": "npm run check:i18n && npm run check:wizard && npm run check:icon && npm run check:format && npm run check:editor && npm run check:semantic && npm run check:workspace",
    "check:semantic": "node --import ./scripts/ts-hook.mjs scripts/check-semantic.mjs"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/theme-one-dark": "6.1.3",
    "@element-plus/icons-vue": "2.3.2",
    "@trimjs/web-app": "^0.4.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "codemirror": "6.0.2",
    "dayjs": "1.11.23",
    "element-plus": "2.14.7",
    "pinia": "4.0.3",
    "vue": "3.5.43",
    "vue-codemirror": "6.1.1",
    "vue-i18n": "11.4.14",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-vue": "6.0.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.2",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  }
}
